# KJLE Local Scraper worker daemon — env template
# Copy to a real env file (NOT committed) and fill in actual values.
# On Linux: /etc/kjle-worker.env (systemd EnvironmentFile)
# On Windows: set via setx or pass through Task Scheduler action

# KJLE backend base URL. Override only if pointing at staging.
KJLE_API_BASE=https://kjle-api.onrender.com

# Worker auth — sent as X-Worker-API-Key on poll/started/complete calls.
# Fetch from Render kjle-api env (WORKER_API_KEY) or KJLE vault.
KJLE_WORKER_API_KEY=REPLACE_ME

# HMAC secret for /kjle/v1/ingest/localscraper. MUST match the value in
# Render kjle-api env var LOCAL_SCRAPER_WEBHOOK_SECRET.
LOCAL_SCRAPER_WEBHOOK_SECRET=REPLACE_ME

# Identifies this worker. Must be exactly 'z820' or 'vps'.
WORKER_ID=z820

# Full path to LocalScraper.exe.
# Windows example: C:\Program Files\LocalScraper\LocalScraper.exe
# Linux example (Wine): /opt/local-scraper/LocalScraper.exe
LOCAL_SCRAPER_EXE_PATH=C:\Program Files\LocalScraper\LocalScraper.exe

# Directory where LocalScraper writes saved scrape JSON files.
# Daemon creates per-job subfolders here and removes them after ingest.
# Windows example: C:\KJLE\scrapes
# Linux example: /var/lib/kjle/scrapes
LOCAL_SCRAPER_SAVE_DIR=C:\KJLE\scrapes

# Poll interval in seconds. Default 15.
POLL_INTERVAL_SEC=15

# Local TCP port where the per-job webhook handler listens (127.0.0.1).
# Must be open on the worker box. Default 8765.
WEBHOOK_HANDLER_PORT=8765

# Log verbosity: DEBUG | INFO | WARNING | ERROR. Default INFO.
LOG_LEVEL=INFO

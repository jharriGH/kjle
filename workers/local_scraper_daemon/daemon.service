[Unit]
Description=KJLE Local Scraper worker daemon (Phase 4.2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace USER with the unprivileged account that owns LOCAL_SCRAPER_SAVE_DIR.
User=REPLACE_ME
WorkingDirectory=/opt/kjle/workers/local_scraper_daemon
# Real env values live here, NEVER in the repo.
EnvironmentFile=/etc/kjle-worker.env
ExecStart=/usr/bin/python3 /opt/kjle/workers/local_scraper_daemon/daemon.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# Be polite to LocalScraper.exe if it's running under Wine — give it time to
# clean up on SIGTERM before we SIGKILL the daemon.
TimeoutStopSec=120
KillMode=mixed

[Install]
WantedBy=multi-user.target

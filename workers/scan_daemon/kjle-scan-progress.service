[Unit]
Description=KJLE Scan Progress Notifier (one-shot, run by timer)
After=network-online.target

[Service]
Type=oneshot
User=ccrunner
WorkingDirectory=/opt/kjle
EnvironmentFile=/etc/kjle-scan-daemon.env
ExecStart=/opt/kjle/workers/scan_daemon/venv/bin/python /opt/kjle/scripts/scan_progress_notify.py
StandardOutput=journal
StandardError=journal
